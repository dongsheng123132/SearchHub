{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "dosen-hecare+",
  "homepage_url": "https://www.hequbing.com",
  "action": {
    "default_title": "1SO SearchHub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "tabGroups",
    "sidePanel",
    "contextMenus",
    "storage",
    "scripting",
    "notifications",
    "system.display"
  ],
  "host_permissions": [],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatglm.cn/*",
        "https://www.doubao.com/*",
        "https://yiyan.baidu.com/*",
        "https://tongyi.aliyun.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.perplexity.ai/*",
        "https://you.com/*",
        "https://metaso.cn/*",
        "https://chat.deepseek.com/*",
        "https://yuanbao.tencent.com/*",
        "https://grok.com/*",
        "https://hailuoai.com/*",
        "https://aistudio.xiaomimimo.com/*",
        "https://xinghuo.xfyun.cn/*",
        "https://www.tiangong.cn/*",
        "https://yuewen.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open 1SO SearchHub"
    },
    "search_selected": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Search selected text"
    }
  }
}